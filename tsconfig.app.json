{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["bun"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/server/*": ["./server/*"],
      "@/zenstack/*": ["./zenstack/*"],
      "@modules/*": ["./modules/*"]
    }
  },
  "include": ["src", "modules"],
  // A module's server half is checked by tsconfig.node.json.
  "exclude": [
    "modules/*/server.ts",
    "modules/*/server/**",
    "modules/*/*.event.ts"
  ]
}
