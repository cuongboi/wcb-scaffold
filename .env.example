# Converted to lower snake case for cookie names: "My App" -> my_app.token
APP_NAME=app
DATABASE_URL=postgres://localhost:5432/fullstack_elysia
BETTER_AUTH_SECRET=change-me-to-32-or-more-random-characters
BETTER_AUTH_URL=http://localhost:3000
PORT=3000
# SENTRY_DSN=

# local | s3
STORAGE_ADAPTER=local
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=10485760

# Required when STORAGE_ADAPTER=s3 (endpoint only for non-AWS services)
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Only read when the server starts with --terminal. Comma-separated user ids that may open a shell
# (a user who isn't listed sees their id in the Terminal panel).
# TERMINAL_USERS=
# Where shells start; defaults to the server's working directory
# TERMINAL_CWD=
