{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node", "bun"],
    "skipLibCheck": true,

    /* Bundler mode */
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/server/*": ["./server/*"],
      "@/zenstack/*": ["./zenstack/*"],
      "@modules/*": ["./modules/*"]
    }
  },
  "include": [
    "build.ts",
    "server",
    "zenstack",
    "scripts",
    "modules/*/server.ts",
    "modules/*/server/**/*.ts",
    "modules/*/*.event.ts"
  ]
}
